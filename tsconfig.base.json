{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@jev/contracts": ["packages/contracts/src/index.ts"],
      "@jev/flow/*": ["packages/jev-flow/src/*"]
    }
  }
}
