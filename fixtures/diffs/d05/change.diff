@@ -0,0 +1,6 @@
+/** Texto de disponibilidad para una variante. Función pura para poder probarla sin render. */
+export function stockLabel(stock: number): string {
+  if (stock <= 0) return 'Agotado en esta combinación';
+  if (stock <= 3) return `Últimas ${stock} piezas`;
+  return 'Disponible';
+}
