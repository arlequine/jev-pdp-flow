+import { describe, expect, it } from 'vitest';
+import { stockLabel } from '../src/features/pdp/stock';
+
+describe('stockLabel', () => {
+  it('agotado, últimas piezas y disponible', () => {
+    expect(stockLabel(0)).toBe('Agotado en esta combinación');
+    expect(stockLabel(2)).toBe('Últimas 2 piezas');
+    expect(stockLabel(9)).toBe('Disponible');
+  });
+});
