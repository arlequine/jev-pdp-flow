# Las keys solo viven aquí. Nunca en apps/web ni en código que llegue al navegador.

# --- Jev: API nativa de TypeSafe (SDK @typesafe-ai/sdk). No se usa OpenRouter. ---
TYPESAFE_API_KEY=
# Opcional: solo si TypeSafe te da otra URL. Por defecto https://api.typesafe.ai
# TYPESAFE_BASE_URL=

# live   = llama a las APIs y no guarda nada
# record = llama a las APIs y guarda cada respuesta en recordings/
# replay = no usa red: responde desde recordings/ y falla si falta una grabación
JEV_MODE=replay

# La demo no usa la API de Anthropic. Claude se usa desde Claude Code (claude) con tu sesión:
#   - el refactor, con Sonnet;
#   - npm run compare, que le pide el orden a Opus con `claude -p --model opus`.
# Opcional: modelo para la comparación (por defecto "opus").
# CLAUDE_COMPARE_MODEL=opus

# --- API local ---
# Latencia simulada por request (ms), igual para endpoints legacy y nuevos.
API_LATENCY_MS=120
